{
  "id": "dw-custom-sheet",
  "title": "Dungeon World Custom Sheet",
  "version": "2.0.0",
  "url": "https://github.com/schnitzel-flammkuchen/foundry-dw-custom-sheet",
  "manifest": "https://raw.githubusercontent.com/schnitzel-flammkuchen/foundry-dw-custom-sheet/main/module.json",
