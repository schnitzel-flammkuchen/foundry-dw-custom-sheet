<form class="dw-custom-sheet {{cssClass}} item-form flexcol" autocomplete="off">
  <div class="sheet-wrapper flexcol">
    <header class="sheet-header flexrow">
      <div class="cell cell--image">
        <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
      </div>
      <div class="header-fields">
          <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize "DW.Common.Name"}}"/></h1>
      </div>
    </header>

    {{!-- Sheet Tab Navigation --}}
    <nav class="sheet-navigation sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="description">{{localize "DW.Common.Description" }}</a>
        <a class="item" data-tab="details">{{localize "DW.Common.Details" }}</a>
    </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab" data-group="primary" data-tab="description">
            {{editor system.descriptionEnriched target="system.description" button=true owner=owner editable=editable engine="prosemirror"}}
        </div>

        {{!-- Details Tab --}}
        <div class="tab" data-group="primary" data-tab="details">
          <div class="resource--tags">
            <label for="tag" class="control-label">{{localize "DW.Tags"}}</label>
            <div class="help-text">
              <p>{{localize "DW.TagsHelp" }}</p>
            </div>
            <input class='tags-input-source' name="system.tags" placeholder="{{localizeFallback "Placeholder.Tags"}}" value="{{system.tags}}">
          </div>
          <div class="grid {{#if (eq system.itemType "weapon")}}grid-4col{{else}}grid-3col{{/if}}">
            {{!-- Equipped --}}
            <div class="resource--item">
              <label>{{localize "DW.Equipped"}}</label>
              <input type="checkbox" name="system.equipped" {{checked system.equipped}}>
            </div>

            {{!-- Magic Item --}}
            <div class="resource--item">
              <label>{{localize "DW.MagicItem"}}</label>
              <input type="checkbox" name="system.magic" {{checked system.magic}}>
            </div>

            {{!-- Item Type --}}
            <div class="resource--item">
              <label>{{localize "DW.ItemType"}}</label>
              <select name="system.itemType" data-dtype="String">
                {{selectOptions selects.itemTypes selected=system.itemType blank='—' localize=true}}
              </select>
            </div>

            {{!-- Damage Override (if weapon) --}}
            {{#if (eq system.itemType "weapon")}}
            <div class="resource--item">
              <label>{{localize "DW.DamageOverride"}}</label>
              <input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="e.g. 1d4+3" data-dtype="String">
            </div>
            {{/if}}
          </div>
          <div class="grid grid-4col">
            {{!-- Quantity --}}
            <div class="resource--item">
              <label>{{localize "DW.Quantity"}}</label>
              <input type="text" name="system.quantity" value="{{system.quantity}}" data-dtype="Number">
            </div>

            {{!-- Uses --}}
            <div class="resource--item">
              <label>{{localize "DW.Uses"}}</label>
              <input type="text" name="system.uses" value="{{system.uses}}" data-dtype="Number">
            </div>

            {{!-- Weight --}}
            <div class="resource--item">
              <label>{{localize "DW.Weight"}}</label>
              <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number">
            </div>

            {{!-- Price --}}
            <div class="resource--item">
              <label>{{localize "DW.Price"}}</label>
              <input type="text" name="system.price" value="{{system.price}}" data-dtype="Number">
            </div>
          </div>
        </div>
    </section>
  </div>
</form>