{{!-- Overview --}}
<div class="overview">
    <div class="sheet-resources">
        {{!-- Forward --}}
        <div class="cell cell--forward">
            <label class="cell__title">{{localize "DW.Forward"}}</label>
            <div class="cell__wrapper">
                <input
                type="number"
                name="system.attributes.forward.value"
                value="{{system.attributes.forward.value}}"
                data-dtype="Number"
                data-stepper
                data-min="0"
                >
            </div>
        </div>


        {{!-- Ongoing --}}
        <div class="cell cell--ongoing">
            <label class="cell__title">{{localize "DW.Ongoing"}}</label>
            <div class="cell__wrapper">
                <input
                type="number"
                name="system.attributes.ongoing.value"
                value="{{system.attributes.ongoing.value}}"
                data-dtype="Number"
                data-stepper
                data-min="0"
                >
            </div>
        </div>


        {{!-- Hold --}}
        <div class="cell cell--hold">
            <label class="cell__title">{{localize "DW.Hold"}}</label>
            <div class="cell__wrapper">
                <input
                type="number"
                name="system.attributes.hold.value"
                value="{{system.attributes.hold.value}}"
                data-dtype="Number"
                data-stepper
                data-min="0"
                >
            </div>
        </div>


        {{!-- Most important resource --}}
        <div class="cell cell--resource1">
            <label class="cell__title">
                <input
                type="text"
                name="system.attributes.resource1.label"
                value="{{system.attributes.resource1.label}}"
                data-dtype="String"
                >
            </label>

            <div class="cell__counter">
                {{!-- Current value --}}
                <input
                    type="number"
                    name="system.attributes.resource1.value"
                    value="{{system.attributes.resource1.value}}"
                    data-dtype="Number"
                    data-stepper
                    data-min="0"
                    data-wrapper=".cell__counter"
                    data-max=".resource1-max"
                >

                <span> / </span>

                {{!-- Max value --}}
                <input
                    type="number"
                    class="resource1-max"
                    name="system.attributes.resource1.max"
                    value="{{system.attributes.resource1.max}}"
                    data-dtype="Number"
                    data-stepper
                    data-min="0"
                >
            </div>
        </div>

        
        {{!-- Roll formula --}}
        <div class="cell cell--roll-formula">
            <label class="cell__title">{{localize "DW.RollFormula"}}</label>
            <div class="cell__wrapper">
                <input type="text" name="system.attributes.rollFormula.value" value="{{system.attributes.rollFormula.value}}"
                    placeholder="2d6" data-dtype="String">
            </div>
        </div>

        {{!-- Roll modes --}}
        <div class="cell cell--roll-mode flexrow">
            <label class="cell__title">
                {{localize "DW.RollMode"}}
            </label>
            {{radioBoxes 'flags.dungeonworld.rollMode' rollModes checked=flags.dungeonworld.rollMode localize=true}}
        </div>
    </div>
</div>