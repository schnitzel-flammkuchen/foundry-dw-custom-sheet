{{!-- Overview --}}
<div class="overview">
    <div class="sheet-resources">
        {{!-- Forward --}}
        <div class="cell cell--forward">
            <label class="cell__title">{{localize "DW.Forward"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.forward.value" value="{{system.attributes.forward.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>


        {{!-- Ongoing --}}
        <div class="cell cell--ongoing">
            <label class="cell__title">{{localize "DW.Ongoing"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.ongoing.value" value="{{system.attributes.ongoing.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>


        {{!-- Hold --}}
        <div class="cell cell--hold">
            <label class="cell__title">{{localize "DW.Hold"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.hold.value" value="{{system.attributes.hold.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>
        
        {{!-- Roll formula --}}
        <div class="cell cell--roll-formula">
            <label class="cell__title">{{localize "DW.RollFormula"}}</label>
            <div class="cell__wrapper">
                <input type="text" name="system.attributes.rollFormula.value" value="{{system.attributes.rollFormula.value}}"
                    placeholder="2d6" data-dtype="String">
            </div>
        </div>

        {{!-- More custom resources (dropdown) --}}
        <section class="tab extra-custom-resources" data-dropdown data-collapsed>
            {{!-- Custom Resources' Dropdown Toggle --}}
            <a class="custom-resources-toggle" data-header>
                <i class="fas fa-chevron-up"></i>
            </a>
            {{!-- Extra custom resources --}}
            <div data-content>
                {{#each customResources}}
                <div class="cell cell--{{this.key}}">
                    {{#if this.removable}}
                    {{!-- Delete button --}}
                    <button type="button" class="resource-control remove-extra-resource" data-resource="{{this.key}}" style="background: transparent !important;" data-ignore>
                        <i class="fas fa-trash" style="color: var(--remove-btn-color) !important;"></i>
                    </button>
                    {{/if}}
                    <label class="cell__title">
                        <input type="text" name="system.attributes.{{this.key}}.label" value="{{this.label}}" data-dtype="String" placeholder="{{localize "DWCS.Custom.DefaultResource"}}" data-required="true">
                    </label>
                    <div class="cell__counter">
                        {{!-- Current value --}}
                        <input type="number" name="system.attributes.{{this.key}}.value" value="{{this.value}}" data-dtype="Number" data-stepper data-min="0" data-wrapper=".cell__counter" data-max=".{{this.key}}-max">
                        <span> / </span>
                        {{!-- Max value --}}
                        <input type="number" class="{{this.key}}-max" name="system.attributes.{{this.key}}.max" value="{{this.max}}" data-dtype="Number" data-stepper data-min="0">
                    </div>
                </div>
                {{/each}}
                {{!-- BUTTON: Add extra resource --}}
                {{#if canAddResource}}
                <div class="cell cell--add-resource" data-ignore>
                    <button type="button" class="resource-control add-extra-resource" data-ignore>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                {{/if}}
            </div>
        </section>

        {{!-- Roll modes --}}
        <div class="cell cell--roll-mode flexrow">
            <label class="cell__title">
                {{localize "DW.RollMode"}}
            </label>
            {{radioBoxes 'flags.dungeonworld.rollMode' rollModes checked=flags.dungeonworld.rollMode localize=true}}
        </div>
    </div>
</div>