{{!-- Overview --}}
<div class="overview">
    <div class="sheet-resources">
        {{!-- Forward --}}
        <div class="cell cell--forward">
            <label class="cell__title">{{localize "DW.Forward"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.forward.value" value="{{system.attributes.forward.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>


        {{!-- Ongoing --}}
        <div class="cell cell--ongoing">
            <label class="cell__title">{{localize "DW.Ongoing"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.ongoing.value" value="{{system.attributes.ongoing.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>


        {{!-- Hold --}}
        <div class="cell cell--hold">
            <label class="cell__title">{{localize "DW.Hold"}}</label>
            <div class="cell__wrapper">
                <input type="number" name="system.attributes.hold.value" value="{{system.attributes.hold.value}}" data-dtype="Number" data-stepper data-min="0">
            </div>
        </div>
        
        {{!-- Roll formula --}}
        <div class="cell cell--roll-formula">
            <label class="cell__title">{{localize "DW.RollFormula"}}</label>
            <div class="cell__wrapper">
                <input type="text" name="system.attributes.rollFormula.value" value="{{system.attributes.rollFormula.value}}"
                    placeholder="2d6" data-dtype="String">
            </div>
        </div>

        {{!-- Roll modes --}}
        <div class="cell cell--roll-mode flexrow">
            <label class="cell__title">
                {{localize "DW.RollMode"}}
            </label>
            {{radioBoxes 'flags.dungeonworld.rollMode' rollModes checked=flags.dungeonworld.rollMode localize=true}}
        </div>
    </div>
</div>