{{!-- Header --}}
<header class="sheet-header">
    <div class="sheet-header__fields">
        {{!-- Name --}}
        <div class="character-name">
            <input type="text" class="input--title" name="name" value="{{actor.name}}" placeholder="{{localizeFallback "Placeholder.Name"}}" data-required="true">
        </div>

        {{!-- Class --}}
        <div class="character-class">
            <select class="input--title charclass" name="system.details.class" aria-placeholder="{{localizeFallback "Placeholder.Class"}}">
                <option value=""></option>
                {{#each system.classlist as |class|}}
                <option value="{{class}}" {{#if (eq class ../system.details.class)}} selected {{/if}}>
                    {{class}}
                </option>
                {{/each}}
            </select>
            <a class="clickable-class-viewer" title="{{localize "DW.ClassViewer"}}">
                <i class="fas fa-book"></i>
            </a>
        </div>
    </div>
</header>