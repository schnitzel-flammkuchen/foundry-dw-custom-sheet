{{!-- Moves tab --}}
<div class="tab moves active" data-group="primary" data-tab="moves">
    
    <section class="notifications">
        {{#if system.isToken}}
        <div class="cell__title warning small-text">
            Moves cannot be rearranged while this token is not linked to an actor.
        </div>
        {{/if}}
    </section>

    {{!-- More custom resources (dropdown) --}}
    <section class="extra-custom-resources">
        {{!-- Toggle button --}}
        <button type="button" class="custom-resources-toggle">
            <i class="fas fa-chevron-down"></i>
        </button>
        {{!-- Extra custom resources --}}
        {{#each customResources}}
        {{#unless (eq this.key "resource1")}}
        <div class="cell cell--{{this.key}}">
            <label class="cell__title">
            <input type="text" name="system.attributes.{{this.key}}.label" value="{{this.label}}" data-dtype="String" placeholder="{{localize "DWCS.Custom.DefaultResource"}}">
            </label>
            <div class="cell__counter">
                <div class="cell__wrapper">
                    {{!-- Current value input --}}
                    <input type="number" class="resource-input current-value" name="system.attributes.{{this.key}}.value" value="{{this.value}}" data-dtype="Number" min="0" max="{{this.max}}">
                    <span> / </span>
                    {{!-- Max value input --}}
                    <input type="number" class="resource-input max-value" name="system.attributes.{{this.key}}.max" value="{{this.max}}" data-dtype="Number" min="1">
                </div>
                <button type="button" class="resource-control remove-extra-resource" data-resource="{{this.key}}">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
        {{/unless}}
        {{/each}}
        
        {{!-- BUTTON: Add extra resource --}}
        {{#if canAddResource}}
        <div class="cell cell--add-resource">
            <button type="button" class="resource-control add-extra-resource">
                <i class="fas fa-plus"></i>
            </button>
        </div>
        {{/if}}
    </section>

    {{#each moveCategories as |category|}}
    <div class="cell cell--{{category.name}}">
        <h2 class="cell__title moves-header">
            <label>
                {{localize category.title}}
                {{!-- For dropdown (initially all open) --}}
                <i class="fas fa-chevron-up"></i> 
            </label>
            <div class="item-controls">
                <button type="button" class="item-control item-create" title="{{localize "DW.MoveCreate"}}" data-type="move" data-moveType="{{category.moveType}}">
                <i class="fas fa-plus"></i>
                </button>
            </div>
        </h2>
        <ol class="items-list">
        {{#each category.moves as |item|}}
        <li class="item flexrow" data-item-id="{{item._id}}" draggable="true">
            {{> "systems/dungeonworld/templates/parts/sheet-moves.html" item=item rollData=../rollData statSettings=../../system.statSettings}}
        </li>
        {{/each}}
        </ol>
    </div>
    {{/each}}

</div>