{{!-- Equipment tabs --}}
<div class="tab equipment" data-group="primary" data-tab="equipment">
    <div class="cell cell--equipment">
        <section class="sheet-notifications">
            {{#if system.isToken}}
            <div class="cell__title warning small-text">
                Equipment cannot be rearranged while this token is not linked to an actor.
            </div>
            {{/if}}
        </section>
        <div class="equipment-info">
            {{!-- Equipment filters --}}
            <div class="item-filters flexrow">
                <label class="{{#if (eq activeFilter 'all')}}selected{{/if}}">
                    <input type="radio" name="itemFilter" value="all" {{#if (eq activeFilter 'all')}}checked{{/if}}>
                    <span>
                        {{localizeFallback "FilteredEquipment.AllItems"}}
                    </span>
                </label>
                {{#each filterTypes as |ftype|}}
                <label class="{{#if (eq ../activeFilter ftype)}}selected{{/if}}">
                    <input type="radio" name="itemFilter" value="{{ftype}}"{{#if (eq ../activeFilter ftype)}}checked{{/if}}>
                    <span>
                        <i class="fas {{lookup ../typeIcons ftype}}" aria-hidden="true"></i>
                        {{localizeFallback (lookup ../typeLabels ftype)}}
                    </span>
                </label>
                {{/each}}
            </div>
            <div class="gold-weight">
                <div class="cell cell--weight">
                    <label for="system.attributes.weight.value" class="cell__title">
                        {{localize "DW.Weight"}}
                        <i class="fas fa-weight-hanging attribute-icon"></i>
                    </label>
                    <div class="cell__counter">
                        {{!-- Current Weight (AUTOMATED - READONLY) --}}
                        <input class="disabled" type="text" name="system.attributes.weight.value" value="{{system.attributes.weight.value}}" data-dtype="Number" readonly="">
                        <span> / </span>
                        {{!-- Max Weight (USER'S INPUT) --}}
                        <input type="text" name="system.attributes.weight.max" value="{{system.attributes.weight.max}}" data-dtype="Number" data-stepper data-min="0">
                    </div>
                </div>
                <div class="cell cell--coin">
                    <label class="cell__title">
                        {{localize "DW.Coin"}}
                        <i class="fas fa-coins attribute-icon"></i>
                    </label>
                    <input type="number" name="system.attributes.coin.value" value="{{system.attributes.coin.value}}" data-dtype="Number" data-stepper data-min="0">
                </div>
            </div>
        </div>
        <h2 class="cell__title equipment-header">
            <div class="equipment-header__left">
                <label class="equipment-title">
                    {{localize "DW.Equipment"}}
                </label>
                {{#if totalWorth}}
                <span class="equipment-worth">
                    {{!-- Between parentesis "( 12 {icon} {label} )" --}}
                    ( {{totalWorth}}
                    <i class="fas fa-sack-dollar"></i>

                    {{#if totalWorthLabel}}
                    <span class="tag">
                        {{localizeFallback totalWorthLabel}}
                    </span>
                    {{/if}}
                    )
                    <span class="tooltip">
                        {{localizeFallback "InventoryTotalWorth"}}
                        {{#if totalWorthLabel}}
                        ({{localizeFallback totalWorthLabel}})
                        {{/if}}
                    </span>
                </span>
                {{/if}}
            </div>
            <div class="item-controls">
                <button  type="button" class="item-control item-create" title="{{localize "DW.Equipment"}}" data-type="equipment">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </h2>
        {{!-- Search bar (initially hidden) --}}
        <div id="equipment-search">
            <input type="text" placeholder="{{localize "DWCS.Custom.SearchItems"}}">
        </div>
        <ol class="items-list">
        {{#each equipment as |item id|}}
        <li class="item {{#if item.system.magic}}magic{{/if}} flexrow" data-item-id="{{item._id}}" data-item-type="{{item.system.itemType}}" draggable="true">
            <h4 class="item-name">
                <div class="item-avatar">
                    <span class="rollable item-rollable" data-roll="{{item.system.rollFormula}}">
                        {{#if item.system.rollFormula}}
                        <i class="fas fa-dice-d20"></i>
                        {{else}}
                        <i class="fas fa-book"></i>
                        {{/if}}
                    </span>
                    <img class="item-icon" src="{{item.img}}" title="{{item.name}}" width="27" height="27">
                </div>
                <span class="item-label">
                    {{item.name}}
                    <span class="item-details-toggle">
                        <i class="fas fa-chevron-down"></i>
                    </span>
                </span>
            </h4>

            <div class="item-meta tags">
                {{#if item.system.equipped}}
                <span class="tag equipped" data-action="equipped">
                    {{localize "DW.Equipped"}}
                </span>
                {{/if}}
                {{#if item.system.uses}}
                <a class="tag counter uses" data-action="uses">
                    {{localize "DW.Uses"}}: {{item.system.uses}}
                </a>
                {{/if}}
                {{#if item.system.quantity}}
                <a class="tag counter quantity" data-action="quantity">
                    {{localize "DW.Qty"}}: {{item.system.quantity}}
                </a>
                {{/if}}{{#if item.system.weight}}
                <span class="tag">
                    {{localize "DW.Wt"}}: {{item.system.weight}}
                </span>
                {{/if}}
            </div>
            <div class="item-controls">
                <a class="item-control item-equip" title="Equip Item">
                    <i class="fa-solid fa-shirt"></i>
                </a>
                <a class="item-control item-edit" title="Edit Item">
                    <i class="fas fa-edit"></i>
                </a>
                <a class="item-control item-delete" title="Delete Item">
                    <i class="fas fa-trash"></i>
                </a>
            </div>
            <div class="item-description">
                {{#if item.system.tags}}
                {{{dwTags item.system.tags}}}
                {{/if}}
                <div class="description">
                    {{{item.system.descriptionEnriched}}}
                </div>
            </div>
        </li>
        {{/each}}
        </ol>
    </div>
</div>