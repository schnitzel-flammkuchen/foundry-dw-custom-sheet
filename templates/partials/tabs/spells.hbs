{{!-- Spells tab --}}
<div class="tab spells" data-group="primary" data-tab="spells">
    <div class="cell cell--spells">
        <section class="sheet-notifications">
            {{#if system.isToken}}
            <div class="cell__title warning small-text">
                {{localize "DWCS.Notifications.NotLinkedToken" item=(localize "DW.Spells")}}
            </div>
            {{/if}}
        </section>

        {{#each spells as |spellsPerLevel spellLevel|}}
        <section class="spell-level spell-level-{{spellLevel}}" data-dropdown>
            <h2 class="cell__title spells-header" data-header>
                <label>
                    {{localize (concat "DW.Spells" spellLevel)}}
                    {{!-- For dropdown (initially all open) --}}
                    <i class="fas fa-chevron-up"></i> 
                </label>
                <div class="item-controls" data-ignore>
                <button type="button" class="item-control item-create" data-type="spell" data-level="{{spellLevel}}" title="{{localize "DW.AddSpell"}}">
                    <i class="fas fa-plus"></i>
                </button>
                </div>
            </h2>

            <ol class="items-list" data-content>
                {{#each spellsPerLevel as |item id|}}
                <li class="item flexrow" data-item-id="{{item._id}}" draggable="true">
                    <h4 class="item-name">
                    <div class="item-avatar">
                        <span class="rollable spell-rollable" data-roll="{{item.system.rollFormula}}">
                        {{#if item.system.rollFormula}}
                        <i class="fas fa-dice-d20"></i>
                        {{else}}
                        <i class="fas fa-book"></i>
                        {{/if}}
                        </span>
                        <img class="item-icon" src="{{item.img}}" title="{{item.name}}" width="27" height="27">
                    </div>
                    <span class="item-label">
                        {{item.name}}
                        <span class="item-details-toggle">
                            <i class="fas fa-chevron-down"></i>
                        </span>
                    </span>
                    </h4>
                    <div class="item-meta tags">
                        {{#if item.system.prepared}}
                        <a class="tag prepared">{{localize "DW.Prepared"}}</a>
                        {{else}}
                        <a class="tag prepared unprepared">{{localize "DW.Unprepared"}}</a>
                        {{/if}}
                    </div>
                    <div class="item-controls">
                        <a class="item-control item-edit" title="{{localizeFallback "Edit"}}">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="item-control item-delete" title="{{localizeFallback "Del"}}">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                    <div class="item-description">
                        <div class="description">
                            {{{item.system.descriptionEnriched}}}
                        </div>
                    </div>
                </li>
                {{/each}}
            </ol>
        </section>
        {{/each}}
    </div>
</div>