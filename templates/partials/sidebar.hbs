{{!-- Sidebar --}}
<aside class="sheet-sidebar">
    <div class="cell cell--aesthetics">
        {{!-- Portrait --}}
        <div class="sheet-portrait">
            <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="profile-img">
        </div>
        {{!-- Attributes --}}
        <div class="sheet-stats">
            <!-- TODO: STATS -->
                <div class="cell cell--damage">

                <label class="cell__title damage-rollable rollable"
                    data-roll="
                        {{system.attributes.damage.value}}
                        {{#if system.attributes.damage.misc}}
                            + {{system.attributes.damage.misc}}
                        {{/if}}"
                    data-label="{{localize "DW.Damage"}}">
                    <i class="fa-thin fa-dice-d20"></i>
                    {{localize "DW.Damage"}}
                </label>
                <div class="damage-inputs">
                    <select name="system.attributes.damage.value" data-dtype="String">
                        {{selectOptions selects.damages selected=system.attributes.damage.value blank='—'}}
                    </select>
                    <span> + </span>
                    <input type="text"
                        name="system.attributes.damage.misc"
                        value="{{system.attributes.damage.misc}}"
                        placeholder="{{localize "DW.Misc"}}"
                        data-dtype="String">
                </div>
            </div>

            {{!-- Stats (Armor and Health) --}}
            <div class="cell--stats-wrapper">
                <div class="cell cell--ac">
                    <label class="cell__title">
                        {{localize "DW.Armor"}}
                        <i class="fas fa-shield-alt attribute-icon"></i>
                    </label>
                    <input type="text" name="system.attributes.ac.value" value="{{system.attributes.ac.value}}" data-dtype="Number"/>
                </div>

                <div class="cell cell--hp">
                    <label for="system.attributes.hp.value"
                        class="cell__title">
                        {{localize "DW.HP"}}
                        <i class="fas fa-heart attribute-icon"></i>
                    </label>
                    <div class="cell__counter">
                    <div class="cell__wrapper">
                        <button type="button"
                            class="resource-control resource-decrease"
                            data-attr="attributes.hp.value"
                            data-action="decrease">
                            -
                        </button>
                        <input type="text" 
                            name="system.attributes.hp.value"
                            value="{{system.attributes.hp.value}}"
                            data-dtype="Number">
                        <button type="button"
                            class="resource-control resource-increase"
                            data-attr="attributes.hp.value"
                            data-action="increase">
                            +
                        </button>
                    </div>
                    <span> / </span>
                    <input type="text"
                        class="hp--max"
                        name="system.attributes.hp.max"
                        value="{{system.attributes.hp.max}}"
                        data-dtype="Number">
                    </div>
                </div>
            </div>

            <div class="cell cell--abilities">
                <ol class="abilities-list">
                {{#each system.abilities as |ability key|}}
                    <li class="ability flexrow" data-ability="{{key}}">
                        <label for="system.abilities.{{key}}.value"
                            class="cell__title ability-rollable rollable"
                            data-roll="{{key}}"
                            data-label="{{ability.label}}">
                            <i class="fat fa-dice-d20"></i>
                            {{localize ability.short}}
                        </label>
                        {{#if ../system.noAbilityScores}}
                            <input class="ability-mod"
                                type="text"
                                name="system.abilities.{{key}}.value"
                                value="
                                    {{#if ability.value}}
                                        {{numberFormat ability.value decimals=0 sign=true}}
                                    {{else}}
                                        0
                                    {{/if}}"
                                    data-dtype="Number">
                        {{else}}
                            <input class="ability-value" type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
                            <span class="ability-mod">
                                {{numberFormat ability.mod decimals=0 sign=true}}
                            </span>
                        {{/if}}
                        <label class="ability-debility checkbox">
                            <input type="checkbox"
                                name="system.abilities.{{key}}.debility"
                                {{checked ability.debility}}>
                                {{ability.debilityLabel}}
                        </label>
                    </li>
                {{/each}}
                </ol>
            </div>
        </div>
    </div>
</aside>