{{!-- Sidebar --}}
<aside class="sheet-sidebar">
    <div class="cell cell--aesthetics">
        <div class="character-xp-wrapper">
            <div class="xp-circle" name="system.attributes.xp.value" data-xp="{{system.attributes.xp.value}}" data-xp-max="{{system.attributes.xp.max}}" data-levelup="{{system.levelup}}">
                <span class="xp-input-wrapper">
                    <i class="fat fa-shuffle edit-xp-icon"></i>
                    <input type="number" name="system.attributes.xp.value" class="xp-input" value="{{system.attributes.xp.value}}" title="XP">
                </span>
                {{!-- Level Input --}}
                {{#if system.levelup}}
                <i class="fas fa-arrow-up level-input clickable-level-up"></i>
                {{else}}
                <input type="text" class="level-input" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number" placeholder="LvL" title="{{localize "DW.Level"}}">
                {{/if}}
                {{!-- Portrait --}}
                <div class="portrait-wrapper">
                    <img src="{{actor.img}}" class="character-portrait" data-edit="img" title="{{actor.name}}">
                </div>
                {{!-- SVG Circular Progress --}}
                <div class="progress-container">
                    <svg viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="54" stroke="#555" stroke-width="6" fill="none"></circle>
                        <circle class="xp-progress" cx="60" cy="60" r="54" stroke="#fff" stroke-width="6" fill="none" stroke-dasharray="339.292" stroke-dashoffset="104.72"></circle>
                    </svg>
                </div>
            </div>
        </div>

        {{!-- Attributes --}}
        <div class="sheet-attributes">

            {{!-- Damage --}}
            <div class="cell cell--damage">
                <label class="cell__title damage-rollable rollable"
                    data-roll=" {{system.attributes.damage.value}} {{#if system.attributes.damage.misc}} + {{system.attributes.damage.misc}} {{/if}}"
                    data-label="{{localize "DW.Damage"}}">
                    <i class="fa-thin fa-dice-d20"></i>
                    {{localize "DW.Damage"}}
                </label>
                <div class="damage-inputs">
                    <select name="system.attributes.damage.value" data-dtype="String">
                        {{selectOptions selects.damages selected=system.attributes.damage.value blank='—'}}
                    </select>
                    <span> + </span>
                    <input type="text" name="system.attributes.damage.misc" value="{{system.attributes.damage.misc}}" placeholder="{{localize "DW.Misc"}}" data-dtype="String">
                </div>
            </div>

            {{!-- attributes (Armor and Health) --}}
            <div class="cell--attributes-wrapper">
                <div class="cell cell--ac">
                    <label class="cell__title">
                        {{localize "DW.Armor"}}
                        <i class="fas fa-shield-alt attribute-icon"></i>
                    </label>
                    <input type="text" name="system.attributes.ac.value" value="{{system.attributes.ac.value}}" data-dtype="Number" data-stepper data-allow-negative/>
                </div>

                <div class="cell cell--hp">
                    <label for="system.attributes.hp.value" class="cell__title">
                        {{localize "DW.HP"}}
                        <i class="fas fa-heart attribute-icon"></i>
                    </label>
                    <div class="cell__counter">
                        <input type="text" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}" data-dtype="Number" data-stepper data-wrapper=".cell__counter" data-max=".hp--max">
                        <span> / </span>
                        <input type="text" class="hp--max" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}" data-dtype="Number" data-max>
                    </div>
                </div>
            </div>

            {{!-- Abilities (STR, DEX, etc.) --}}
            <div class="cell cell--abilities">
                <ol class="abilities-list">
                {{#each system.abilities as |ability key|}}
                <li class="ability-item" data-ability="{{key}}">
                    <div class="ability-top">
                        <label for="system.abilities.{{key}}.value" class="cell__title ability-rollable rollable" data-roll="{{key}}" data-label="{{ability.label}}">
                            <i class="fat fa-dice-d20"></i>
                            {{localize ability.short}}
                        </label>
                        {{#if ../system.noAbilityScores}}
                        <input class="ability-mod" type="text" name="system.abilities.{{key}}.value" value="{{#if ability.value}}{{numberFormat ability.value decimals=0 sign=true}}{{else}}0{{/if}}" data-dtype="Number" title="{{#if ability.debility}}-1{{/if}}">
                        {{else}}
                        <span class="ability-mod">
                            {{numberFormat ability.mod decimals=0 sign=true}}
                        </span>
                        <input class="ability-value" type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number">
                        {{/if}}
                    </div>
                    <div class="ability-bottom">
                        <label class="ability-debility checkbox">
                            <input type="checkbox" name="system.abilities.{{key}}.debility"
                                {{checked ability.debility}}>
                                {{ability.debilityLabel}}
                                {{#if ability.debility}}
                                <span class="ability-mod">
                                    {{!-- Between parentesis after label --}}
                                    {{!-- Default HARDCODED '-1' due to debilities only applying + (-1) on mods --}}
                                    (-1)
                                </span>
                                {{/if}}
                        </label>
                    </div>
                </li>
                {{/each}}
                </ol>
            </div>

            {{!-- Sidebar Custom Moves --}}
            {{#if moveCategoriesSidebar.length}}
            <div class="sidebar-moves">
                {{#each moveCategoriesSidebar as |category|}}
                <div class="cell cell--{{category.name}} cell--item-list" data-dropdown>
                    <h4 class="cell__title" data-header>
                        <label>
                            {{localize category.title}}
                            <i class="fas fa-chevron-up"></i>
                        </label>

                        <div class="item-controls" data-ignore>
                            <button type="button" class="item-control item-create" title="{{localize "DW.MoveCreate"}}" data-type="move" data-moveType="{{category.moveType}}">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </h4>

                    <ol class="items-list" data-content>
                        {{#each category.moves as |item|}}
                        <li class="item flexrow" data-item-id="{{item._id}}" draggable="true">
                            {{> "systems/dungeonworld/templates/parts/sheet-moves.html" item=item rollData=../rollData statSettings=../../system.statSettings}}
                        </li>
                        {{/each}}
                    </ol>
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>
</aside>