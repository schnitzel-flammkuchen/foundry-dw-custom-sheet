<form class="dw-custom-sheet {{cssClass}}" autocomplete="off">

    <div class="sheet-wrapper">
        {{!-- Sidebar --}}
        {{> "modules/dw-custom-sheet/templates/character/partials/sidebar.hbs"}}

        {{!-- Body --}}
        <div class="sheet-body">
            {{!-- Header --}}
            {{> "modules/dw-custom-sheet/templates/character/partials/header.hbs"}}

            {{!-- Main --}}
            <div class="sheet-main">
                {{!-- Forward, Ongoing, Hold, Resource and Roll formula & modes --}}
                {{> "modules/dw-custom-sheet/templates/character/partials/overview.hbs"}}

                {{!-- Navigation tabs --}}
                <nav class="sheet-tabs tabs" data-group="primary">
                    <a class="item" data-tab="description">{{localize "DW.Description"}}</a>
                    <a class="item" data-tab="moves">{{localize "DW.Moves"}}</a>
                    <a class="item" data-tab="spells">{{localize "DW.Spells"}}</a>
                    <a class="item" data-tab="equipment">{{localize "DW.Equipment"}}</a>
                </nav>

                {{!-- Tabs section --}}
                <section class="tabs-section">
                    {{!-- Description tab --}}
                    {{> "modules/dw-custom-sheet/templates/character/partials/tabs/description.hbs"}}

                    {{!-- Moves tab --}}
                    {{> "modules/dw-custom-sheet/templates/character/partials/tabs/moves.hbs"}}

                    {{!-- Spells tab --}}
                    {{> "modules/dw-custom-sheet/templates/character/partials/tabs/spells.hbs"}}

                    {{!-- Equipment tabs --}}
                    {{> "modules/dw-custom-sheet/templates/character/partials/tabs/equipment.hbs"}}
                </section>

            </div>
        </div>
    </div>

</form>