<form>
  <table>
    <thead>
      <tr>
        <th>{{localize "DOCUMENT.User"}}</th>
        <th>{{localize "PERMISSION.Permission"}} {{localize "EDITOR.Secret"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each players}}
      <tr>
        <td>{{this.name}}</td>
        <td><input type="checkbox" data-id="{{this.id}}" {{#if this.hasAccess}}checked{{/if}}></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <button type="submit">{{localize "EDITOR.Save"}}</button>
</form>